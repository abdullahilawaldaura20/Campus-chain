SECRET_KEY=change-this-to-a-random-string

# For local development, either set DATABASE_URL directly:
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/campuschain
# ...or set these individual components (used only if DATABASE_URL is unset):
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campuschain

ALLOWED_EMAIL_DOMAIN=
